# Required: secret used to sign and verify JWTs.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional: log level for the winston logger (error | warn | info | debug)
LOG_LEVEL=info

# Shared secret authorizing the game-notifier bot to POST /api/map-snapshots.
# Must match INGEST_SECRET in /Users/kr1/gerard/game-notifier/.env.
# Generate with: openssl rand -hex 32
INGEST_SECRET=
