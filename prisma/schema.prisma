generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./sauron.db"
}

model Events {
  id             Int        @id @default(autoincrement())
  event          String
  details        String?
  fromCol        String
  withWhom       String?
  date           String
  calculatedDate DateTime?
  territory      String     @default("Unknown Territory")
  source         String     @default("extension")
  characterId    Int
  createdAt      DateTime   @default(now())
  character      Characters @relation(fields: [characterId], references: [id])
}

model Factions {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  characters Characters[]
  forums     Forums[]
}

model Characters {
  id           Int                  @id @default(autoincrement())
  targetId     Int                  @unique
  name         String
  rank         String?
  popularity   String?
  role         String?
  portraitUrl  String?
  factionId    Int?
  createdAt    DateTime             @default(now())
  attributes   CharacterAttributes?
  storyHistory CharacterHistory[]
  logs         CharacterLog[]
  faction      Factions?            @relation(fields: [factionId], references: [id])
  equipment    Equipment[]
  events       Events[]
  mdjHistory   MDJHistory[]
  mapTiles     MapTiles[]
  messages     Messages[]
  topics       Topics[]

  @@index([targetId])
}

model Equipment {
  id           Int        @id @default(autoincrement())
  name         String
  description  String
  type         String
  price        Int?
  imageUrl     String?
  thumbnailUrl String?
  characterId  Int
  character    Characters @relation(fields: [characterId], references: [id])
}

model MDJHistory {
  id          Int        @id @default(autoincrement())
  characterId Int
  mdj         String
  createdAt   DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterHistory {
  id          Int        @id @default(autoincrement())
  characterId Int
  story       String
  modifiedAt  DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterLog {
  id          Int        @id @default(autoincrement())
  characterId Int
  attribute   String
  oldValue    String?
  newValue    String?
  changedAt   DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterAttributes {
  id          Int        @id @default(autoincrement())
  characterId Int        @unique
  raceId      Int?
  race        Race?      @relation(fields: [raceId], references: [id])
  cc          Int
  ct          Int
  f           Int
  e           Int
  agi         Int
  pv          Int
  pm          Int
  fm          Int
  m           Int
  a           Int
  mvt         Int
  p           Int
  r           Int
  rm          Int
  xp          Int
  spd         Int       @default(16)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  character   Characters @relation(fields: [characterId], references: [id])

  @@index([raceId])
}

model Race {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  characters  CharacterAttributes[]
}

model Forums {
  id        Int       @id @default(autoincrement())
  name      String
  link      String    @unique
  type      String
  factionId Int?
  faction   Factions? @relation(fields: [factionId], references: [id])
  topics    Topics[]
}

model Topics {
  id       Int        @id @default(autoincrement())
  name     String
  link     String     @unique
  authorId Int
  forumId  Int
  messages Messages[]
  forum    Forums     @relation(fields: [forumId], references: [id])
  author   Characters @relation(fields: [authorId], references: [id])
}

model Messages {
  id          Int        @id @default(autoincrement())
  content     String
  date        String
  createdAt   DateTime   @default(now())
  characterId Int
  topicId     Int
  topic       Topics     @relation(fields: [topicId], references: [id])
  character   Characters @relation(fields: [characterId], references: [id])
}

model Maps {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  coords Coords[]
}

model Coords {
  id          Int           @id @default(autoincrement())
  x           Int           @default(0)
  y           Int           @default(0)
  z           Int           @default(0)
  mapId       Int
  map         Maps          @relation(fields: [mapId], references: [id])
  mapElements MapElements[]
  mapTiles    MapTiles[]

  @@index([mapId])
}

model MapTiles {
  id         Int         @id @default(autoincrement())
  name       String
  coordsId   Int
  foreground Int         @default(0)
  playerId   Int?
  player     Characters? @relation(fields: [playerId], references: [id])
  coords     Coords      @relation(fields: [coordsId], references: [id])

  @@index([coordsId])
  @@index([playerId])
}

model MapElements {
  id       Int    @id @default(autoincrement())
  name     String @unique
  coordsId Int
  endTime  Int    @default(0)
  coords   Coords @relation(fields: [coordsId], references: [id])

  @@unique([name, coordsId])
  @@index([coordsId])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
