generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./sauron.db"
}

model Events {
  id             Int        @id @default(autoincrement())
  event          String
  details        String?
  fromCol        String
  withWhom       String?
  date           String
  calculatedDate DateTime?
  territory      String     @default("Unknown Territory")
  source         String     @default("extension")
  characterId    Int
  createdAt      DateTime   @default(now())
  character      Characters @relation(fields: [characterId], references: [id])
}

model Factions {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  characters Characters[]
  forums     Forums[]
}

model Characters {
  id           Int                  @id @default(autoincrement())
  targetId     Int                  @unique
  name         String
  rank         String?
  popularity   String?
  role         String?
  race         String?
  portraitUrl  String?
  factionId      Int?
  coordsId       Int?
  mapAvatarHref  String?              // small sprite seen on the world map
  mapColor       String?              // race bgColor the engine paints around the player tile
  createdAt      DateTime             @default(now())
  attributes   CharacterAttributes?
  storyHistory CharacterHistory[]
  logs         CharacterLog[]
  faction      Factions?            @relation(fields: [factionId], references: [id])
  coords       Coords?              @relation("CharacterAtCoords", fields: [coordsId], references: [id])
  equipment    Equipment[]
  events       Events[]
  mdjHistory   MDJHistory[]
  mapTiles     MapTiles[]
  mapWalls     MapWalls[]
  mapRoutes    MapRoutes[]          @relation("RoutesByPlayer")
  messages     Messages[]
  topics       Topics[]
  users        User[]
  quests       Quest[]
  questRoles   QuestActor[]         @relation("QuestActors")
  combatAssignment CombatAssignment?

  @@index([targetId])
  @@index([coordsId])
}

model Equipment {
  id           Int        @id @default(autoincrement())
  gameId       String?
  name         String
  description  String
  type         String
  price        Int?
  imageUrl     String?
  thumbnailUrl String?
  characterId  Int
  character    Characters @relation(fields: [characterId], references: [id])

  @@unique([characterId, gameId])
}

model MDJHistory {
  id          Int        @id @default(autoincrement())
  characterId Int
  mdj         String
  createdAt   DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterHistory {
  id          Int        @id @default(autoincrement())
  characterId Int
  story       String
  modifiedAt  DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterLog {
  id          Int        @id @default(autoincrement())
  characterId Int
  attribute   String
  oldValue    String?
  newValue    String?
  changedAt   DateTime   @default(now())
  character   Characters @relation(fields: [characterId], references: [id])
}

model CharacterAttributes {
  id          Int        @id @default(autoincrement())
  characterId Int        @unique
  raceId      Int?
  race        Race?      @relation(fields: [raceId], references: [id])
  cc          Int
  ct          Int
  f           Int
  e           Int
  agi         Int
  pv          Int
  pm          Int
  fm          Int
  m           Int
  a           Int
  mvt         Int
  p           Int
  r           Int
  rm          Int
  xp          Int
  spd         Int       @default(16)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  character   Characters @relation(fields: [characterId], references: [id])

  @@index([raceId])
}

model Race {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  characters  CharacterAttributes[]
}

model Forums {
  id        Int       @id @default(autoincrement())
  name      String
  link      String    @unique
  type      String
  factionId Int?
  faction   Factions? @relation(fields: [factionId], references: [id])
  topics    Topics[]
}

model Topics {
  id        Int          @id @default(autoincrement())
  name      String
  link      String       @unique
  authorId  Int
  forumId   Int
  closed    Boolean      @default(false)
  updatedAt DateTime     @updatedAt
  messages  Messages[]
  forum     Forums       @relation(fields: [forumId], references: [id])
  author    Characters   @relation(fields: [authorId], references: [id])
  quests    QuestTopic[]
}

model Messages {
  id          Int            @id @default(autoincrement())
  content     String
  date        String
  createdAt   DateTime       @default(now())
  characterId Int
  topicId     Int
  topic       Topics         @relation(fields: [topicId], references: [id])
  character   Characters     @relation(fields: [characterId], references: [id])
  quests      QuestMessage[]
}

// ─── Quêtes ───────────────────────────────────────────────────────────
// Intrigues sans résolution qu'un personnage suit, ou dans lesquelles il
// pourrait vouloir s'impliquer. Rien ici n'est scrapé : une quête est soit
// saisie à la main, soit issue d'une détection IA validée par l'auteur
// (`origin`). Le fil de discussion reste la source, la quête n'en est que
// la lecture narrative.

model Quest {
  id          Int          @id @default(autoincrement())
  characterId Int                             // le carnet de quêtes de qui
  title       String
  summary     String?                         // l'intrigue, en quelques lignes
  stake       String?                         // enjeu : pourquoi ce personnage s'en mêle
  nextStep    String?                         // prochaine action concrète
  status      String       @default("lead")   // lead | engaged | waiting | closed | dismissed
  origin      String       @default("manual") // manual | ai
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  character   Characters   @relation(fields: [characterId], references: [id])
  topics      QuestTopic[]
  actors      QuestActor[]
  anchors     QuestMessage[]

  @@index([characterId])
  @@index([status])
}

// Un fil (RP, missive, forum privé) qui porte l'intrigue. La fraîcheur de la
// quête se lit sur le dernier message de ces fils, jamais sur updatedAt.
model QuestTopic {
  id      Int     @id @default(autoincrement())
  questId Int
  topicId Int
  note    String?
  quest   Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  topic   Topics  @relation(fields: [topicId], references: [id])

  @@unique([questId, topicId])
  @@index([topicId])
}

// Le message précis qui porte la preuve : la phrase où la promesse est faite, où
// la question reste sans réponse. Une intrigue longue se lit dans trois dates,
// pas dans vingt fils. Ancrage facultatif : une quête vaut sans lui.
model QuestMessage {
  id        Int      @id @default(autoincrement())
  questId   Int
  messageId Int
  note      String?
  quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  message   Messages @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([questId, messageId])
  @@index([messageId])
}

model QuestActor {
  id          Int        @id @default(autoincrement())
  questId     Int
  characterId Int
  role        String?                          // "commanditaire", "témoin", "adversaire"…
  quest       Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  character   Characters @relation("QuestActors", fields: [characterId], references: [id])

  @@unique([questId, characterId])
  @@index([characterId])
}

// ─── Map ──────────────────────────────────────────────────────────────
// Mirrors the game's `coords + map_tiles + map_walls + map_elements +
// map_foregrounds + map_routes` schema. Populated incrementally by the
// extension as the player explores.

// Static metadata about a "plan" (zone/area). Seeded from the engine's
// datas/private/plans/*.json. Coords.plan is a loose String reference —
// no FK so unknown plans don't break ingest.
model Plan {
  name              String       @id          // "olympia", "cimes_geantes"
  displayName       String                    // "Olympia", "Cimes Géantes"
  shortName         String?
  worldX            Int?                       // position in the global plan grid
  worldY            Int?
  visibleByDefault  Boolean      @default(false)
  visibleBoundsMinX Int?
  visibleBoundsMaxX Int?
  visibleBoundsMinY Int?
  visibleBoundsMaxY Int?
  numZLevels        Int          @default(1)
  pnjSeedId         Int?                       // first PNJ id from the engine's "pnj" field
  metadata          String?                    // raw JSON (biomes, etc.) for forensics
  zLevels           PlanZLevel[]
  exitsFrom         PlanExit[]   @relation("ExitFrom")
  exitsTo           PlanExit[]   @relation("ExitTo")
}

model PlanZLevel {
  id                Int     @id @default(autoincrement())
  planName          String
  z                 Int
  zName             String?
  // Per-z backdrop scraped from the SVG container's `background: url(...)`
  // (e.g. img/tiles/sky.webp for an open-air upper level). Overrides the
  // plan-level guessed bg when the renderer paints this z-level.
  bg                String?
  visibleBoundsMinX Int?
  visibleBoundsMaxX Int?
  visibleBoundsMinY Int?
  visibleBoundsMaxY Int?
  plan              Plan    @relation(fields: [planName], references: [name], onDelete: Cascade)

  @@unique([planName, z])
  @@index([planName])
}

model PlanExit {
  id        Int    @id @default(autoincrement())
  planFrom  String
  planTo    String
  direction String                   // n, s, e, w, ne, se, nw, sw
  fromPlan  Plan   @relation("ExitFrom", fields: [planFrom], references: [name], onDelete: Cascade)
  toPlan    Plan   @relation("ExitTo",   fields: [planTo],   references: [name], onDelete: Cascade)

  @@index([planFrom])
  @@index([planTo])
}

model Coords {
  id    Int    @id @default(autoincrement())
  x     Int
  y     Int
  z     Int    @default(0)
  plan  String @default("gaia")

  // Persona (AOM targetId) that revealed this cell. NULL or positive = a PJ
  // ("canon", e.g. medarda) and always visible; negative = a PNJ, hidden from
  // the default map view and shown only when its persona layer is toggled on.
  // A PJ scrape always upgrades the cell to canon; a PNJ never downgrades it.
  seenById Int?

  mapTiles       MapTiles[]
  mapWalls       MapWalls[]
  mapElements    MapElements[]
  mapForegrounds MapForegrounds[]
  mapRoutes      MapRoutes[]
  mapPlants      MapPlants[]
  charactersHere Characters[]    @relation("CharacterAtCoords")

  @@unique([x, y, z, plan])
  @@index([plan])
  @@index([seenById])
}

model MapTiles {
  id         Int         @id @default(autoincrement())
  name       String
  href       String?
  coordsId   Int
  foreground Int         @default(0)
  playerId   Int?        // owner (e.g. faction camps)
  scrapedAt  DateTime    @updatedAt
  player     Characters? @relation(fields: [playerId], references: [id])
  coords     Coords      @relation(fields: [coordsId], references: [id])

  @@unique([coordsId, name])
  @@index([coordsId])
  @@index([playerId])
}

model MapWalls {
  id        Int         @id @default(autoincrement())
  name      String
  href      String?
  coordsId  Int
  playerId  Int?
  damages   Int         @default(0)
  scrapedAt DateTime    @updatedAt
  player    Characters? @relation(fields: [playerId], references: [id])
  coords    Coords      @relation(fields: [coordsId], references: [id])

  @@unique([coordsId, name])
  @@index([coordsId])
  @@index([playerId])
}

model MapElements {
  id        Int      @id @default(autoincrement())
  name      String
  href      String?
  coordsId  Int
  endTime   Int      @default(0)
  opacity   Float    @default(1.0)
  scrapedAt DateTime @updatedAt
  coords    Coords   @relation(fields: [coordsId], references: [id])

  @@unique([name, coordsId])
  @@index([coordsId])
}

model MapForegrounds {
  id        Int      @id @default(autoincrement())
  name      String
  href      String?
  coordsId  Int
  scrapedAt DateTime @updatedAt
  coords    Coords   @relation(fields: [coordsId], references: [id])

  @@unique([coordsId, name])
  @@index([coordsId])
}

model MapRoutes {
  id        Int         @id @default(autoincrement())
  name      String      @default("route")
  href      String?
  coordsId  Int
  playerId  Int?
  scrapedAt DateTime    @updatedAt
  coords    Coords      @relation(fields: [coordsId], references: [id])
  player    Characters? @relation("RoutesByPlayer", fields: [playerId], references: [id])

  @@unique([coordsId, name])
  @@index([coordsId])
  @@index([playerId])
}

model MapPlants {
  id        Int      @id @default(autoincrement())
  name      String
  href      String?
  coordsId  Int
  scrapedAt DateTime @updatedAt
  coords    Coords   @relation(fields: [coordsId], references: [id])

  @@unique([coordsId, name])
  @@index([coordsId])
}

model MapSnapshot {
  id         Int                @id @default(autoincrement())
  capturedAt DateTime           @unique
  svgWidth   Int                @default(800)
  svgHeight  Int                @default(532)
  playerId   Int?
  createdAt  DateTime           @default(now())
  layers     MapSnapshotLayer[]

  @@index([capturedAt])
}

model MapSnapshotLayer {
  id          Int         @id @default(autoincrement())
  snapshotId  Int
  layerKey    String
  sourceHref  String
  contentHash String
  filePath    String
  x           Int
  y           Int
  width       Int
  height      Int
  zOrder      Int
  snapshot    MapSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([contentHash])
}

model User {
  id         Int          @id @default(autoincrement())
  username   String       @unique
  password   String
  role       String       @default("user") // "user" | "admin"
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  characters Characters[]
}

// Événement de combat de guilde (ex: dragons) : liste de monstres avec leurs
// caracs, et pour chaque joueur le monstre qu'il a déclaré affronter + une
// heure de tour de référence. Les tours du jeu durent 18h : à partir de cette
// heure de référence, le front calcule les prochains tours (+18h, +36h, ...).
// Accès public en lecture/écriture (pas d'auth) : outil de coordination
// éphémère utilisé en direct par toute la guilde, pas seulement les
// personnages liés au compte admin.
model Monster {
  id          Int                @id @default(autoincrement())
  name        String
  imageUrl    String?
  cc          Int?
  ct          Int?
  f           Int?
  e           Int?
  agi         Int?
  pv          Int?
  pm          Int?
  fm          Int?
  m           Int?
  a           Int?
  mvt         Int?
  p           Int?
  r           Int?
  rm          Int?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments CombatAssignment[]
}

model CombatAssignment {
  id          Int        @id @default(autoincrement())
  characterId Int        @unique
  character   Characters @relation(fields: [characterId], references: [id])
  monsterId   Int?
  monster     Monster?   @relation(fields: [monsterId], references: [id])
  turnTime    DateTime?
  note        String?
  updatedAt   DateTime   @updatedAt

  @@index([monsterId])
}

